<html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Digital Designing Shop | Master Admin Hub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --accent: #ffd700; --bg: #080808; }
        body { background-color: var(--bg); color: white; font-family: 'Poppins', sans-serif; }
        .gold-border { border: 1px solid var(--accent); }
        .glass { background: rgba(255,255,255,0.05); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.1); }
        .shop-banner { background: linear-gradient(45deg, #1a1a1a, #2a2a2a); border-radius: 20px; }
        .hidden-sec { display: none; }
        .ai-lady-bot { position: fixed; bottom: 20px; right: 20px; width: 70px; cursor: pointer; z-index: 1000; transition: 0.5s; filter: drop-shadow(0 0 10px #ffd700); }
    </style>
</head>
<body>

    <nav class="p-4 glass sticky top-0 z-50 flex justify-between items-center px-8 border-b border-zinc-800">
        <div class="text-xl font-black italic gold-text">DIGITAL <span class="text-white">DESIGNING</span></div>
        <div class="flex gap-6 text-xs font-bold uppercase tracking-widest">
            <button onclick="viewMode('public')" class="hover:text-yellow-500">Public View</button>
            <button onclick="viewMode('admin')" class="hover:text-yellow-500">Admin/Shop</button>
            <button onclick="viewMode('owner')" class="bg-yellow-600 text-black px-4 py-1 rounded-full">Owner Master</button>
        </div>
    </nav>

    <section id="owner-sec" class="container mx-auto p-6 animate-slideIn">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
            <div class="glass p-6 rounded-2xl">
                <p class="text-gray-400 text-xs">Total Click Revenue (₹1/click)</p>
                <h3 class="text-2xl font-bold">₹8,420</h3>
            </div>
            <div class="glass p-6 rounded-2xl text-green-400">
                <p class="text-gray-400 text-xs">Total Download Revenue (₹10/item)</p>
                <h3 class="text-2xl font-bold">₹15,100</h3>
            </div>
            <div class="glass p-6 rounded-2xl text-yellow-500">
                <p class="text-gray-400 text-xs">Admin Franchise Fees (₹500)</p>
                <h3 class="text-2xl font-bold">₹25,000</h3>
            </div>
            <div class="glass p-6 rounded-2xl text-blue-400">
                <p class="text-gray-400 text-xs">WhatsApp Enquiries</p>
                <h3 class="text-2xl font-bold">42</h3>
            </div>
        </div>

        <div class="glass p-8 rounded-3xl mb-8">
            <h2 class="text-xl font-bold mb-4 italic">Generate Shop Reference (₹500 Fee)</h2>
            <div class="flex gap-4">
                <input type="text" id="refName" placeholder="Business Name (e.g. Sadi ki Dukaan)" class="flex-grow bg-black border border-zinc-700 p-3 rounded-xl outline-none focus:border-yellow-500">
                <button onclick="generateRef()" class="bg-yellow-600 text-black px-8 py-3 rounded-xl font-black uppercase">Create & Share</button>
            </div>
        </div>
    </section>

    <section id="admin-sec" class="hidden-sec container mx-auto p-6">
        <div class="max-w-2xl mx-auto glass p-10 rounded-[40px] text-center shadow-2xl border-2 border-yellow-600/20">
            <h2 class="text-3xl font-black mb-4">Start Your Digital Shop</h2>
            <p class="text-gray-400 mb-8">Sirf ₹500 mein apni poori dukaan online karein. Hum aapko hosting aur AI assistant free denge.</p>
            
            <div class="space-y-4 text-left">
                <label class="text-xs uppercase text-yellow-500 font-bold">Step 1: Shop Details</label>
                <input type="text" placeholder="Apna Business Naam" class="w-full bg-zinc-900 p-4 rounded-2xl border border-zinc-800">
                <input type="number" placeholder="WhatsApp Number (Payment ke liye)" id="adminWhatsApp" class="w-full bg-zinc-900 p-4 rounded-2xl border border-zinc-800">
                
                <div class="shop-banner p-6 text-center border border-zinc-700">
                    <i class="fas fa-store text-4xl mb-2 text-yellow-600"></i>
                    <p class="font-bold italic">Aapka Banner Yahan Dikhega</p>
                </div>

                <button onclick="pay500()" class="w-full bg-white text-black py-4 rounded-2xl font-black text-xl hover:bg-yellow-500 transition">Pay ₹500 & Go Live</button>
            </div>
        </div>
    </section>

    <section id="public-sec" class="hidden-sec container mx-auto p-6">
        <div class="text-center mb-12">
            <h1 class="text-6xl font-black italic mb-2 tracking-tighter">DIGITAL <span class="text-yellow-500">SHOP</span></h1>
            <p class="text-gray-500 uppercase tracking-widest text-sm font-bold">High-End Custom Designing & Downloads</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="glass p-2 rounded-2xl group relative overflow-hidden" onclick="clickPay()">
                <img src="https://images.unsplash.com/photo-1512295767273-ac109ac3acfa?auto=format&fit=crop&w=500&q=80" class="w-full h-96 object-cover rounded-xl filter blur-md group-hover:blur-sm transition">
                <div class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center">
                    <span class="bg-yellow-600 text-black px-4 py-1 rounded-full text-[10px] font-black mb-2">PREMIUM DESIGN</span>
                    <button class="bg-white text-black px-6 py-2 rounded-full font-bold shadow-xl">₹1 Click to Preview</button>
                    <button onclick="downloadPay(event)" class="mt-4 text-xs text-yellow-500 underline uppercase font-bold tracking-tighter">Download Original (₹10)</button>
                </div>
            </div>
            </div>

        <div class="mt-20 text-center glass p-10 rounded-3xl max-w-xl mx-auto">
            <h3 class="text-2xl font-bold mb-4">Custom Design Chahie?</h3>
            <p class="text-gray-400 mb-6 text-sm">Apni photo bhejye, hum use ekdam brand jaisa design karke denge.</p>
            <button onclick="contactWhatsApp()" class="bg-green-600 px-10 py-4 rounded-full font-black flex items-center gap-4 mx-auto hover:scale-105 transition">
                <i class="fab fa-whatsapp text-2xl"></i> WHATSAPP US NOW
            </button>
        </div>
    </section>

    <img src="https://cdn-icons-png.flaticon.com/512/4712/4712139.png" class="ai-lady-bot" onclick="toggleAIChat()">

    <div id="aiBox" class="hidden-sec fixed bottom-24 right-6 w-80 h-[400px] glass rounded-3xl shadow-2xl z-[2000] p-4 flex flex-col border-yellow-500/30 border">
        <div class="flex justify-between items-center mb-4 border-b border-zinc-800 pb-2">
            <span class="text-xs font-bold text-yellow-500">AI MONEY MANAGER</span>
            <button onclick="toggleAIChat()">×</button>
        </div>
        <div id="aiMessages" class="flex-grow overflow-y-auto text-xs space-y-3">
            <p class="bg-zinc-800 p-3 rounded-2xl rounded-tl-none italic">Vijay ji, Main aapke sare click aur payments track kar rahi hoon. Kaunsa master update chahiye?</p>
        </div>
        <div class="mt-4">
            <input type="text" id="aiInp" placeholder="Type command..." class="w-full bg-black border border-zinc-800 rounded-full px-4 py-2 text-xs">
        </div>
    </div>

    <script>
        let currentMode = 'owner';
        let myWhatsApp = "919876543210"; // Aapka Default Number

        function viewMode(type) {
            document.getElementById('owner-sec').classList.add('hidden-sec');
            document.getElementById('admin-sec').classList.add('hidden-sec');
            document.getElementById('public-sec').classList.add('hidden-sec');
            document.getElementById(type + '-sec').classList.remove('hidden-sec');
            currentMode = type;
        }

        function clickPay() {
            if(currentMode !== 'owner') {
                alert("🔒 ACCESS LOCKED: Please pay ₹1 via UPI to view this digital showroom.");
            } else {
                alert("OWNER ACCESS: Free Preview mode active.");
            }
        }

        function downloadPay(e) {
            e.stopPropagation();
            alert("📥 DOWNLOAD REQUEST: Pay ₹10 to save this Ultra-HD Design to your gallery.");
        }

        function pay500() {
            alert("💳 FRANCHISE PAYMENT: Opening UPI for ₹500. After payment, your shop banner and link will be publicly active.");
        }

        function generateRef() {
            const name = document.getElementById('refName').value;
            if(!name) return alert("Pehle business ka naam likhein!");
            const link = `https://vijaydigital.com/shop?ref=${name.replace(/\s+/g, '_')}`;
            alert(`Link Generated for ${name}!\nAb ise WhatsApp par share karein.`);
            window.open(`https://wa.me/?text=Meri digital dukaan dekhein: ${link}`);
        }

        function contactWhatsApp() {
            window.open(`https://wa.me/${myWhatsApp}?text=Hello Vijay, Mujhe ek custom design karwana hai.`);
        }

        function toggleAIChat() {
            document.getElementById('aiBox').classList.toggle('hidden-sec');
        }

        // AI Chat Simulation
        document.getElementById('aiInp').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') {
                let msg = e.target.value;
                document.getElementById('aiMessages').innerHTML += `<p class="text-right text-yellow-500"><b>You:</b> ${msg}</p>`;
                setTimeout(() => {
                    document.getElementById('aiMessages').innerHTML += `<p class="bg-zinc-800 p-3 rounded-2xl italic"><b>AI:</b> Task received. Designing algorithms update kar diye hain.</p>`;
                }, 1000);
                e.target.value = "";
            }
        });
    </script>
</body>
</html>
